# Environment: development / production
ENVIRONMENT=production

# Database Credentials
POSTGRES_USER=smartstock
POSTGRES_PASSWORD=smartstock_secure_password
POSTGRES_DB=smartstock

# Database Connection URL (used by backend)
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://smartstock:smartstock_secure_password@db:5432/smartstock

# Redis Connection URL
REDIS_URL=redis://redis:6379

# JWT Security
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=generate_a_secure_random_key_here
